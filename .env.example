# EDAflow Environment Configuration
APP_NAME=EDAflow
APP_VERSION=1.0.0
ENV=production
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# Storage & Uploads
MAX_UPLOAD_SIZE_MB=100
STORAGE_RETENTION_HOURS=24

# Sampling & Limits
SAMPLING_THRESHOLD=100000
SAMPLE_SIZE=50000
MAX_COLUMNS_FOR_CORRELATION=100
